      "source": [
        "# 10) Score before/after post-processing\n",
        "f0,a0,o0 = score(preds)\n",
        "preds_pp = [{**p, \"arguments\": postprocess(p[\"tool_called\"], p[\"arguments\"], r[\"text\"])}\n",
        "            for p, r in zip(preds, dev_raw)]\n",
        "f1,a1,o1 = score(preds_pp)\n",
        "print(f\"RAW  FnAcc {f0:.3f}  ArgEM {a0:.3f}  OverallA {o0:.3f}\")\n",
        "print(f\"+PP  FnAcc {f1:.3f}  ArgEM {a1:.3f}  OverallA {o1:.3f}\")\n",
        "print(\"baseline to beat: OverallA 0.766\")"
