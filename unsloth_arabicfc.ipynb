      "source": [
        "# 7) Trainer with completion masking\n",
        "from trl import SFTTrainer, SFTConfig\n",
        "from unsloth.chat_templates import train_on_responses_only\n",
        "\n",
        "trainer = SFTTrainer(\n",
        "    model = model,\n",
        "    tokenizer = tokenizer,          # if this errors, rename to processing_class = tokenizer\n",
        "    train_dataset = sft_train,\n",
        "    args = SFTConfig(\n",
        "        dataset_text_field = \"text\",\n",
        "        max_seq_length = max_seq_length,\n",
        "        per_device_train_batch_size = 8,\n",
        "        gradient_accumulation_steps = 2,\n",
        "        warmup_steps = 20,\n",
        "        num_train_epochs = 2,\n",
        "        learning_rate = 2e-4,\n",
        "        logging_steps = 20,\n",
        "        optim = \"adamw_8bit\",\n",
        "        weight_decay = 0.01,\n",
        "        lr_scheduler_type = \"cosine\",\n",
        "        seed = 3407,\n",
        "        output_dir = \"outputs\",\n",
        "        report_to = \"none\",\n",
        "        dataset_kwargs = {\"add_special_tokens\": False},  # data already has <bos>\n",
        "    ),\n",
        ")\n",
        "\n",
        "# loss only on the model's answer, not the long declaration prompt\n",
        "trainer = train_on_responses_only(\n",
        "    trainer,\n",
        "    instruction_part = \"<start_of_turn>user\\n\",\n",
        "    response_part = \"<start_of_turn>model\\n\",\n",
        ")"
      ],
      "id": "0mF8aZaEn-Re"
    },
